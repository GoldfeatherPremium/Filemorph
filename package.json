{
  "name": "filemorph",
  "version": "0.1.0",
  "private": true,
  "description": "FileMorph — Every file. Every format. One beautiful workspace.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @filemorph/web",
    "build": "npm run build --workspace @filemorph/web",
    "start": "npm run start --workspace @filemorph/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker": "npm run start --workspace @filemorph/worker"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.1.0"
}
